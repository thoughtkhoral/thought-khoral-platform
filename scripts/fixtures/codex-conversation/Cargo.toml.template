[package]
name = "task9-codex-conversation-fixture"
version = "0.1.0"
edition = "2024"
license = "Apache-2.0"
publish = false

[dependencies]
thought-khoral-room-gateway = { path = __BROKER__ }
thought-khoral-agent-gateway = { path = __MEDIATOR__ }
thought-khoral-codex-agent = { path = __WORKER__ }
axum = "=0.8.9"
base64 = "=0.22.1"
chrono = { version = "=0.4.45", features = ["serde"] }
jsonwebtoken = { version = "=11.0.0", default-features = false, features = ["rust_crypto"] }
libc = "=0.2.189"
rand = "=0.8.8"
reqwest = { version = "=0.13.5", default-features = false, features = ["json", "rustls"] }
rsa = "=0.9.10"
serde = { version = "=1.0.229", features = ["derive"] }
serde_json = "=1.0.151"
sqlx = { version = "=0.8.6", default-features = false, features = ["runtime-tokio-rustls", "postgres", "sqlite", "uuid", "chrono", "json"] }
tokio = { version = "=1.53.1", features = ["macros", "rt-multi-thread", "net", "process", "sync", "time"] }
uuid = { version = "=1.26.1", features = ["serde", "v4"] }

[patch.crates-io]
a2a-client-lf = { path = __MEDIATOR_VENDOR__ }
